  "main": "server.js",
  "scripts": {
    "test": "jest",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "npx prisma generate && tsc && cp -r src/emails dist/emails",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "db:seed": "prisma db seed",
    "db:seed:reset": "SEED_RESET=true prisma db seed",
    "db:products:backfill-images": "tsx prisma/backfillProductImages.ts",
    "db:make-admin": "tsx prisma/makeAdmin.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
