generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum UserRole {
  USER
  ADMIN
}

enum CancelledBy {
  USER
  ADMIN
  SYSTEM
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  BONUS
  EXPIRED
}

enum ReferralStatus {
  PENDING
  COMPLETED
}

enum PromotionType {
  FLASH_SALE
  PERCENTAGE_OFF_CATEGORY
}

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  NEW_RETURN
  NEW_CONTACT
  NEW_REVIEW
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
}

model Category {
  category_id Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
  updatedAt   DateTime    @updatedAt @db.Timestamp(6)
  products    Products[]
  promotions  Promotion[]
}

model Products {
  product_id   String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  description  String?
  price        Float
  unit         String?   @db.VarChar(50)
  image        String?
  images       String[]  @default([])
  discount     Float?
  stock        Int       @default(0)
  availability Boolean   @default(true)
  brand        String?   @db.VarChar(100)
  rating       Float?
  category_id  Int?
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @db.Timestamp(6)
  deletedAt    DateTime?
  category     Category? @relation(fields: [category_id], references: [category_id])
  reviews      Review[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  variants     ProductVariant[]
  questions    ProductQuestion[]
  priceHistory PriceHistory[]
  wishlists    Wishlist[]
  backInStockSubscriptions BackInStockSubscription[]
  tags         ProductTag[]
  attributes   ProductAttribute[]

  @@index([category_id])
  @@index([createdAt(sort: Desc)])
  @@index([price])
  @@index([rating])
  @@index([availability])
  @@index([category_id, createdAt(sort: Desc)])
  @@index([deletedAt])
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  password           String
  roles              UserRole  @default(USER)
  phoneNumber        String?
  profileImage       String    @default("default.jpg")
  referralCode       String?   @unique @db.VarChar(20)
  addresses          Address[]
  orders             Order[]
  cart               Cart?
  reviews            Review[]
  reviewVotes        ReviewVote[]
  questions          ProductQuestion[]
  answers            ProductAnswer[]
  wishlist           Wishlist[]
  returnRequests     ReturnRequest[]
  backInStockSubscriptions BackInStockSubscription[]
  loyaltyAccount     LoyaltyAccount?
  sentReferrals      Referral[]  @relation("SentReferrals")
  receivedReferral   Referral?   @relation("ReceivedReferral")
  purchasedGiftCards GiftCard[]  @relation("GiftCardPurchased")

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isVerified         Boolean   @default(false)
  resetToken         String?
  resetTokenExpiry   DateTime?
  passwordChangedAt  DateTime?
  verifyToken        String?
  verifyTokenExpiry  DateTime?
  active             Boolean   @default(true)
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  city      String
  state     String?
  zipCode   String?
  country   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
}

model Order {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       OrderStatus  @default(PENDING)
  total        Float
  shippingName    String?
  shippingStreet  String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?
  shippingCost    Float     @default(0)
  shippingZoneId  String?
  shippingZone    ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  trackingNumber  String?
  shippingLabel   String?
  shippedAt       DateTime?
  easypostShipmentId String?

  discountAmount Float     @default(0)
  couponCode   String?

  items        OrderItem[]

  stripeSessionId String?      @unique
  returnRequest ReturnRequest?


  cancelledAt  DateTime?
  cancelledBy  CancelledBy?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product_id  String          @db.Uuid
  product     Products        @relation(fields: [product_id], references: [product_id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?
  quantity    Int
  price       Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId])
  @@index([product_id])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product_id String          @db.Uuid
  product    Products        @relation(fields: [product_id], references: [product_id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([cartId])
}

model Review {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product_id String       @db.Uuid
  product    Products     @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  content    String?
  rating     Float
  verifiedPurchase Boolean @default(false)
  votes      ReviewVote[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, product_id])
}

model ReviewVote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@index([userId])
}

model ProductVariant {
  id            String      @id @default(uuid())
  product_id    String      @db.Uuid
  product       Products    @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  name          String      @db.VarChar(100)
  priceModifier Float       @default(0)
  stock         Int         @default(0)
  availability  Boolean     @default(true)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([product_id])
}

model ProductQuestion {
  id         String          @id @default(uuid())
  product_id String          @db.Uuid
  product    Products        @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answers    ProductAnswer[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([product_id])
  @@index([createdAt(sort: Desc)])
}

model ProductAnswer {
  id         String          @id @default(uuid())
  questionId String
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([questionId])
}

model PriceHistory {
  id         String   @id @default(uuid())
  product_id String   @db.Uuid
  product    Products @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  price      Float
  createdAt  DateTime @default(now())

  @@index([product_id])
  @@index([product_id, createdAt(sort: Desc)])
}

model Wishlist {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product_id String   @db.Uuid
  product    Products @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, product_id])
  @@index([userId])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([read])
}
model Coupon {
    id            String    @id @default(uuid())
    code          String    @unique @db.VarChar(50)
    type          CouponType
    value         Float
    minOrderTotal Float?
    maxUses       Int?
    usedCount      Int       @default(0)
    expiresAt     DateTime?
    active        Boolean   @default(true)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    @@index([code])
    @@index([active, expiresAt])
}

model ReturnRequest {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    ReturnStatus @default(PENDING)
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orderId])
  @@index([userId])
  @@index([status])
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique @db.VarChar(100)
  slug      String       @unique @db.VarChar(100)
  products  ProductTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([slug])
}

model ProductTag {
  productId  String   @db.Uuid
  product    Products @relation(fields: [productId], references: [product_id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@index([productId])
}

model ProductAttribute {
  id         String   @id @default(uuid())
  product_id String   @db.Uuid
  product    Products @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  key        String   @db.VarChar(100)
  value      String   @db.VarChar(200)
  createdAt  DateTime @default(now())

  @@index([product_id])
  @@index([key, value])
}

model BackInStockSubscription {
  id         String    @id @default(uuid())
  email      String
  product_id String    @db.Uuid
  product    Products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  notified   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@unique([email, product_id])
  @@index([product_id, notified])
}

model Promotion {
  id         String        @id @default(uuid())
  name       String        @db.VarChar(200)
  type       PromotionType
  value      Float
  categoryId Int?
  category   Category?     @relation(fields: [categoryId], references: [category_id], onDelete: SetNull)
  startsAt   DateTime
  endsAt     DateTime
  active     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([active])
  @@index([active, startsAt, endsAt])
}

model Banner {
  id        String    @id @default(uuid())
  title     String    @db.VarChar(200)
  subtitle  String?   @db.VarChar(400)
  imageUrl  String
  linkUrl   String?
  position  String    @db.VarChar(50)
  active    Boolean   @default(true)
  order     Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position, active])
  @@index([active, startsAt, endsAt])
}

model AdminNotification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([read, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ShippingZone {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(100)
  countries     String[]
  flatRate      Float
  freeThreshold Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([active])
}

model LoyaltyAccount {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  points         Int                  @default(0)
  lifetimePoints Int                  @default(0)
  tier           Tier                 @default(BRONZE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  transactions   LoyaltyTransaction[]

  @@index([userId])
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  accountId   String
  account     LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        LoyaltyTransactionType
  points      Int
  description String?                @db.VarChar(300)
  orderId     String?
  createdAt   DateTime               @default(now())

  @@index([accountId])
  @@index([createdAt(sort: Desc)])
}

model GiftCard {
  id             String               @id @default(uuid())
  code           String               @unique @db.VarChar(20)
  balance        Float
  initialBalance Float
  purchasedById  String
  purchasedBy    User                 @relation("GiftCardPurchased", fields: [purchasedById], references: [id])
  recipientEmail String?
  active         Boolean              @default(true)
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  redemptions    GiftCardRedemption[]

  @@index([code])
  @@index([active])
}

model GiftCardRedemption {
  id         String   @id @default(uuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  orderId    String
  amount     Float
  createdAt  DateTime @default(now())

  @@index([giftCardId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  sessionId String   @db.VarChar(100)
  userId    String?
  event     String   @db.VarChar(50)
  productId String?  @db.Uuid
  metadata  Json?
  ip        String?  @db.VarChar(45)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([event, createdAt(sort: Desc)])
  @@index([userId])
  @@index([productId])
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
}

model Referral {
  id          String         @id @default(uuid())
  referrerId  String
  referrer    User           @relation("SentReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId   String         @unique
  referee     User           @relation("ReceivedReferral", fields: [refereeId], references: [id], onDelete: Cascade)
  status      ReferralStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([referrerId])
}
