<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Order Confirmed</title>
  </head>
  <body style="margin:0; padding:0; background:#f4f4f4; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding:40px 20px;">
          <table width="600" cellpadding="0" cellspacing="0" style="background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
            <!-- Header -->
            <tr>
              <td style="background:#000; padding:28px 32px;">
                <h1 style="color:#fff; margin:0; font-size:22px; font-weight:700; letter-spacing:-0.5px;">Northline</h1>
              </td>
            </tr>
            <!-- Body -->
            <tr>
              <td style="padding:36px 32px;">
                <h2 style="color:#111; margin:0 0 8px; font-size:22px;">Order confirmed, {{name}}!</h2>
                <p style="color:#666; margin:0 0 28px; font-size:15px; line-height:1.5;">
                  Thank you for your purchase. We've received your payment and your order is now being processed.
                </p>

                <!-- Order ID -->
                <div style="background:#f9f9f9; border-radius:8px; padding:16px 20px; margin-bottom:28px;">
                  <p style="margin:0 0 4px; color:#888; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">Order number</p>
                  <p style="margin:0; color:#111; font-size:20px; font-weight:700; letter-spacing:2px;">#{{orderId}}</p>
                </div>

                <!-- Items -->
                <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                  <tr>
                    <td style="padding-bottom:8px; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; color:#888; border-bottom:1px solid #eee;">Item</td>
                    <td align="center" style="padding-bottom:8px; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; color:#888; border-bottom:1px solid #eee;">Qty</td>
                    <td align="right" style="padding-bottom:8px; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; color:#888; border-bottom:1px solid #eee;">Price</td>
                  </tr>
                  {{#each items}}
                  <tr>
                    <td style="padding:12px 0 12px; font-size:14px; color:#333; border-bottom:1px solid #f0f0f0;">{{this.name}}</td>
                    <td align="center" style="padding:12px 0 12px; font-size:14px; color:#555; border-bottom:1px solid #f0f0f0;">{{this.quantity}}</td>
                    <td align="right" style="padding:12px 0 12px; font-size:14px; color:#333; font-weight:600; border-bottom:1px solid #f0f0f0;">${{this.price}}</td>
                  </tr>
                  {{/each}}
                </table>

                <!-- Totals -->
                {{#if discountAmount}}
                <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:4px;">
                  <tr>
                    <td style="font-size:14px; color:#666;">Discount</td>
                    <td align="right" style="font-size:14px; color:#16a34a; font-weight:600;">-${{discountAmount}}</td>
                  </tr>
                </table>
                {{/if}}
                <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:32px; border-top:2px solid #111; padding-top:12px;">
                  <tr>
                    <td style="padding-top:12px; font-size:16px; color:#111; font-weight:700;">Total</td>
                    <td align="right" style="padding-top:12px; font-size:18px; color:#111; font-weight:700;">${{total}}</td>
                  </tr>
                </table>

                <!-- CTA -->
                <div style="text-align:center; margin-bottom:32px;">
                  <a href="{{orderUrl}}" style="display:inline-block; background:#000; color:#fff; text-decoration:none; padding:14px 32px; border-radius:8px; font-size:15px; font-weight:600;">View order details</a>
                </div>

                <p style="color:#aaa; font-size:13px; line-height:1.6; margin:0;">
                  You'll receive another email when your order ships. If you have any questions, reply to this email or visit your account page.
                </p>
              </td>
            </tr>
            <!-- Footer -->
            <tr>
              <td style="background:#f9f9f9; padding:20px 32px; border-top:1px solid #eee;">
                <p style="margin:0; color:#aaa; font-size:12px;">© {{year}} Northline. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
